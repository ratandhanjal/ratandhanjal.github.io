---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/work', label: 'Work' },
  { href: '/now', label: 'Now' },
  { href: '/blog', label: 'Blog' },
  { href: '/habits', label: 'Habits' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="container header-container">
    <a href="/" class="logo">
      <span class="logo-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
      </span>
      <span class="font-serif">RD.</span>
    </a>
    
    <div class="nav-actions-wrapper">
      <nav class="main-nav" id="main-nav">
        {navItems.map(item => (
          <a 
            href={item.href} 
            class={`nav-link ${currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'active' : ''}`}
          >
            {item.label}
          </a>
        ))}
      </nav>
      
      <div class="actions">
        <button id="theme-toggle" class="theme-toggle icon-btn" aria-label="Toggle Theme">
          <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </button>
        
        <button id="mobile-toggle" class="mobile-toggle icon-btn" aria-label="Toggle Menu">
          <svg class="menu-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          <svg class="close-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--bg-color);
    border-bottom: 1px solid var(--border-color);
    padding: var(--space-md) 0;
    backdrop-filter: blur(10px);
    background-color: color-mix(in srgb, var(--bg-color) 80%, transparent);
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--text-color);
  }
  
  .font-serif {
    font-family: var(--font-serif);
  }

  .nav-actions-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .nav-link {
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-weight: 500;
    position: relative;
    text-decoration: none;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--text-color);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--text-color);
    border-radius: var(--radius-full);
  }

  .icon-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xs);
    border-radius: var(--radius-md);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .icon-btn:hover {
    color: var(--text-color);
    background-color: var(--border-color);
  }

  .mobile-toggle {
    display: none; /* hidden on desktop */
  }

  .close-icon {
    display: none;
  }

  /* Handle theme toggle icons */
  :global([data-theme='dark']) .sun-icon { display: block; }
  :global([data-theme='dark']) .moon-icon { display: none; }
  :global([data-theme='light']) .sun-icon { display: none; }
  :global([data-theme='light']) .moon-icon { display: block; }

  @media (max-width: 768px) {
    .nav-actions-wrapper {
      gap: var(--space-sm);
    }
    
    .mobile-toggle {
      display: flex;
    }

    .main-nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background-color: var(--bg-color);
      flex-direction: column;
      align-items: center;
      padding: var(--space-lg) 0;
      gap: var(--space-lg);
      border-bottom: 1px solid var(--border-color);
      box-shadow: 0 10px 20px rgba(0,0,0,0.05);
      
      /* Hidden by default on mobile */
      display: none;
    }

    /* When the mobile menu is open */
    .header.menu-open .main-nav {
      display: flex;
    }

    .header.menu-open .menu-icon {
      display: none;
    }

    .header.menu-open .close-icon {
      display: block;
    }

    .nav-link {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  
  themeToggle?.addEventListener('click', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme');
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    
    document.documentElement.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
  });

  // Mobile menu toggle
  const mobileToggle = document.getElementById('mobile-toggle');
  const header = document.querySelector('.header');

  mobileToggle?.addEventListener('click', () => {
    header?.classList.toggle('menu-open');
  });
</script>

---
import Layout from '../layouts/Layout.astro';
import profileData from '../data/profile.json';
---

<Layout title="Contact | Ratan Dhanjal">
  <div class="container page-container fade-in">
    <div class="contact-card card glass-effect stagger-1">
      <h1 class="font-serif">Let's talk.</h1>
      
      <p class="description">
        I am currently open to freelance projects, technical consulting, and interesting collaboration opportunities.
      </p>

      <div class="contact-methods">
        <a href={`mailto:${profileData.email}`} class="contact-link primary-link">
          <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </span>
          <span class="text">{profileData.email}</span>
        </a>
        
        <div class="social-links mt-lg">
          <p class="tag">Also find me on</p>
          <div class="flex gap-md">
            <a href={profileData.socials.github} target="_blank" rel="noopener noreferrer" class="social-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              GitHub
            </a>
            <a href={profileData.socials.linkedin} target="_blank" rel="noopener noreferrer" class="social-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    padding-top: var(--space-4xl);
    padding-bottom: var(--space-4xl);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(100vh - 200px);
  }

  .contact-card {
    max-width: 600px;
    width: 100%;
    padding: var(--space-3xl);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background-color: var(--bg-color-secondary);
    text-align: center;
    box-shadow: 0 20px 40px rgba(0,0,0,0.05);
  }

  :global([data-theme='dark']) .contact-card {
    box-shadow: 0 20px 40px rgba(0,0,0,0.5);
  }

  .font-serif {
    font-family: var(--font-serif);
    font-size: 3.5rem;
    margin-bottom: var(--space-md);
    margin-top: 0;
  }

  .description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-2xl);
    line-height: 1.6;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
  }

  .primary-link {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--text-color);
    padding: var(--space-md) var(--space-xl);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .primary-link:hover {
    border-color: var(--text-color);
    background-color: var(--text-color);
    color: var(--bg-color);
  }

  .primary-link:hover .icon {
    transform: scale(1.1);
  }

  .icon {
    display: flex;
    transition: transform var(--transition-fast);
  }

  .social-links {
    margin-top: var(--space-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tag {
    margin-bottom: var(--space-sm);
  }

  .social-btn {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    font-size: 0.95rem;
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .social-btn:hover {
    color: var(--text-color);
    border-color: var(--border-color-hover);
    background-color: var(--bg-color);
  }

  .stagger-1 {
    opacity: 0;
    animation: slideUp var(--transition-slow) forwards;
  }
  
  @media (max-width: 600px) {
    .contact-card {
      padding: var(--space-xl);
    }
    
    .font-serif {
      font-size: 2.5rem;
    }
    
    .primary-link {
      font-size: 1.25rem;
      padding: var(--space-sm) var(--space-lg);
    }
    
    .social-links .flex {
      flex-direction: column;
    }
  }
</style>

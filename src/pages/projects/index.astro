---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
  title="Projects | Ratan Dhanjal"
  description="Open source projects and personal builds by Ratan Dhanjal — DevOps, automation, cloud tooling, and developer utilities."
>
  <div class="container page-container fade-in">
    <header class="page-header stagger-1">
      <h1 class="font-serif">Projects</h1>
      <p class="subtitle">Open source tools, automation scripts, and personal engineering projects.</p>
    </header>

    <div class="project-list stagger-2">
      {projects.length > 0 ? (
        projects.map((project) => (
          <article class="project-item" data-status={project.data.status?.toLowerCase() ?? ''}>
            <div class="item-content">
              <div class="item-meta">
                <span class="tag">
                  {project.data.techStack.slice(0, 3).join(' · ')}
                  {project.data.techStack.length > 3 && ` · +${project.data.techStack.length - 3} more`}
                </span>
                {project.data.status && (
                  <span class={`status-badge status-${project.data.status.toLowerCase().replace(' ', '-')}`}>
                    {project.data.status}
                  </span>
                )}
              </div>

              <h2>{project.data.name}</h2>
              <p class="item-description">{project.data.description}</p>

              <div class="item-links">
                {project.data.github && (
                  <a
                    href={project.data.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="item-link"
                    id={`github-${project.id}`}
                    aria-label={`View ${project.data.name} on GitHub`}
                    onclick="event.stopPropagation()"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                    GitHub
                  </a>
                )}
                {project.data.link && (
                  <a
                    href={project.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="item-link"
                    id={`live-${project.id}`}
                    aria-label={`View ${project.data.name} live`}
                    onclick="event.stopPropagation()"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                    Live Demo
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      ) : (
        <p class="empty-state">Projects coming soon. Stay tuned!</p>
      )}
    </div>

    <p class="footer-note stagger-3">
      More on <a href="https://github.com/ratandhanjal" target="_blank" rel="noopener noreferrer" id="github-profile-footer">GitHub →</a>
    </p>
  </div>
</Layout>

<style>
  /* ── Page ────────────────────────────────────────────────────────────── */
  .page-container {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-4xl);
    max-width: 800px;
  }

  .page-header {
    margin-bottom: var(--space-3xl);
  }

  .font-serif {
    font-family: var(--font-serif);
    font-size: 3rem;
    margin-bottom: var(--space-sm);
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: 1.25rem;
    margin: 0;
  }

  /* ── List ────────────────────────────────────────────────────────────── */
  .project-list {
    display: flex;
    flex-direction: column;
  }

  .project-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xl);
    padding: var(--space-2xl) 0;
    border-bottom: 1px solid var(--border-color);
    transition: opacity var(--transition-fast);
  }

  .project-item:hover {
    opacity: 0.8;
  }

  .project-item:last-child {
    border-bottom: none;
  }

  /* ── Item Content ────────────────────────────────────────────────────── */
  .item-content {
    flex: 1;
    min-width: 0;
  }

  .item-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-sm);
    font-size: 0.85rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }

  .tag {
    color: var(--text-secondary);
  }

  .project-item h2 {
    font-size: 1.75rem;
    margin-top: 0;
    margin-bottom: var(--space-sm);
    color: var(--text-color);
    line-height: 1.3;
  }

  .item-description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0 0 var(--space-md) 0;
  }

  /* ── Links ───────────────────────────────────────────────────────────── */
  .item-links {
    display: flex;
    gap: var(--space-lg);
  }

  .item-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .item-link:hover {
    color: var(--text-color);
  }

  /* ── Status Badge ────────────────────────────────────────────────────── */
  .status-badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    border: 1px solid;
  }

  .status-active {
    color: #16a34a;
    border-color: rgba(34, 197, 94, 0.3);
    background: rgba(34, 197, 94, 0.08);
  }

  .status-completed {
    color: var(--text-tertiary);
    border-color: var(--border-color);
    background: transparent;
  }

  .status-in-progress {
    color: #ca8a04;
    border-color: rgba(234, 179, 8, 0.3);
    background: rgba(234, 179, 8, 0.08);
  }

  :global([data-theme='dark']) .status-active {
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.25);
  }

  :global([data-theme='dark']) .status-in-progress {
    color: #fde047;
    border-color: rgba(253, 224, 71, 0.25);
  }

  /* ── Empty / Footer ──────────────────────────────────────────────────── */
  .empty-state {
    color: var(--text-tertiary);
    font-style: italic;
  }

  .footer-note {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .footer-note a {
    color: var(--text-color);
    font-weight: 500;
  }

  /* ── Stagger ─────────────────────────────────────────────────────────── */
  .stagger-1, .stagger-2, .stagger-3 {
    opacity: 0;
    animation: slideUp var(--transition-slow) forwards;
  }
  .stagger-1 { animation-delay: 100ms; }
  .stagger-2 { animation-delay: 200ms; }
  .stagger-3 { animation-delay: 350ms; }
</style>

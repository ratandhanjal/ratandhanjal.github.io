---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const statusColors: Record<string, string> = {
  'Active': 'status-active',
  'In Progress': 'status-progress',
  'Completed': 'status-completed',
};
---

<Layout
  title="Projects | Ratan Dhanjal"
  description="Open source projects and personal builds by Ratan Dhanjal — DevOps, automation, cloud tooling, and developer utilities."
>
  <div class="container page-container fade-in">
    <header class="page-header stagger-1">
      <p class="tag">What I build</p>
      <h1 class="font-serif">Projects</h1>
      <p class="subtitle">
        Open source tools, automation scripts, and personal engineering projects.
      </p>
    </header>

    {projects.length === 0 ? (
      <div class="empty-state stagger-2">
        <p class="empty-icon" aria-hidden="true">🛠️</p>
        <h2>Projects coming soon</h2>
        <p>Working on some things to share here. Check back soon!</p>
        <a href="https://github.com/ratandhanjal" target="_blank" rel="noopener noreferrer" class="btn" id="github-profile-link">
          View GitHub Profile
        </a>
      </div>
    ) : (
      <div class="projects-grid stagger-2">
        {projects.map((project) => (
          <article class="project-card">
            <div class="card-header">
              <h2 class="project-name">{project.data.name}</h2>
              {project.data.status && (
                <span class={`status-badge ${statusColors[project.data.status] || ''}`}>
                  {project.data.status}
                </span>
              )}
            </div>

            <p class="project-description">{project.data.description}</p>

            {project.data.problem && (
              <div class="project-detail">
                <p class="detail-label">Problem</p>
                <p class="detail-text">{project.data.problem}</p>
              </div>
            )}

            {project.data.solution && (
              <div class="project-detail">
                <p class="detail-label">Solution</p>
                <p class="detail-text">{project.data.solution}</p>
              </div>
            )}

            <div class="tech-tags">
              {project.data.techStack.map((tech) => (
                <span class="tag tech-tag">{tech}</span>
              ))}
            </div>

            <div class="card-footer">
              {project.data.github && (
                <a
                  href={project.data.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-link"
                  aria-label={`View ${project.data.name} on GitHub`}
                  id={`github-${project.id}`}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
                  View on GitHub
                </a>
              )}
              {project.data.link && (
                <a
                  href={project.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-link"
                  aria-label={`View ${project.data.name} live`}
                  id={`live-${project.id}`}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                  Live Demo
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    )}

    <div class="contribute-note stagger-3">
      <p>
        More projects on
        <a href="https://github.com/ratandhanjal" target="_blank" rel="noopener noreferrer" id="github-more-link">GitHub →</a>
      </p>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-4xl);
  }

  .page-header {
    margin-bottom: var(--space-3xl);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: var(--space-xl);
  }

  .page-header .tag {
    display: block;
    margin-bottom: var(--space-sm);
  }

  .font-serif {
    font-family: var(--font-serif);
    font-size: 3rem;
    margin-bottom: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin: 0;
    line-height: 1.6;
  }

  /* ── Projects Grid ───────────────────────────────────────────────────── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-xl);
  }

  .project-card {
    background-color: var(--bg-color-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    transition: border-color var(--transition-fast), transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .project-card:hover {
    border-color: var(--border-color-hover);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  }

  :global([data-theme='dark']) .project-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }

  /* ── Card Header ─────────────────────────────────────────────────────── */
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .project-name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    margin: 0;
    line-height: 1.2;
  }

  .status-badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    border: 1px solid;
    flex-shrink: 0;
    margin-top: 4px;
  }

  .status-active {
    color: #16a34a;
    border-color: rgba(34, 197, 94, 0.3);
    background: rgba(34, 197, 94, 0.08);
  }

  .status-completed {
    color: var(--text-tertiary);
    border-color: var(--border-color);
    background: transparent;
  }

  .status-progress {
    color: #ca8a04;
    border-color: rgba(234, 179, 8, 0.3);
    background: rgba(234, 179, 8, 0.08);
  }

  :global([data-theme='dark']) .status-active {
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.25);
  }

  :global([data-theme='dark']) .status-progress {
    color: #fde047;
    border-color: rgba(253, 224, 71, 0.25);
  }

  /* ── Card Body ───────────────────────────────────────────────────────── */
  .project-description {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.65;
    margin: 0;
  }

  .project-detail {
    border-left: 2px solid var(--border-color);
    padding-left: var(--space-md);
  }

  .detail-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    margin: 0 0 4px 0;
  }

  .detail-text {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Tech Tags ───────────────────────────────────────────────────────── */
  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: auto;
  }

  .tech-tag {
    font-size: 0.72rem;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-color);
    background-color: var(--bg-color);
    color: var(--text-secondary);
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
  }

  /* ── Card Footer ─────────────────────────────────────────────────────── */
  .card-footer {
    display: flex;
    gap: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--border-color);
    flex-wrap: wrap;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
    text-decoration: none;
  }

  .project-link:hover {
    color: var(--text-color);
  }

  /* ── Empty State ─────────────────────────────────────────────────────── */
  .empty-state {
    text-align: center;
    padding: var(--space-4xl) 0;
    color: var(--text-secondary);
  }

  .empty-icon {
    font-size: 3rem;
    margin-bottom: var(--space-lg);
  }

  .empty-state h2 {
    font-family: var(--font-serif);
    margin-bottom: var(--space-md);
  }

  .empty-state .btn {
    margin-top: var(--space-xl);
  }

  /* ── Footer note ─────────────────────────────────────────────────────── */
  .contribute-note {
    margin-top: var(--space-3xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border-color);
    text-align: center;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .contribute-note a {
    color: var(--text-color);
    font-weight: 500;
  }

  /* ── Stagger ─────────────────────────────────────────────────────────── */
  .stagger-1, .stagger-2, .stagger-3 {
    opacity: 0;
    animation: slideUp var(--transition-slow) forwards;
  }
  .stagger-1 { animation-delay: 100ms; }
  .stagger-2 { animation-delay: 200ms; }
  .stagger-3 { animation-delay: 400ms; }

  /* ── Responsive ──────────────────────────────────────────────────────── */
  @media (max-width: 600px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

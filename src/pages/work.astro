---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Work & Experience | Ratan Dhanjal">
  <div class="container page-container fade-in">
    <header class="page-header stagger-1">
      <h1 class="font-serif">Work</h1>
      <p class="subtitle">My professional journey in cloud and infrastructure.</p>
    </header>

    <div class="timeline stagger-2">
      
      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-date">July 2025 – Present</span>
        </div>
        <div class="timeline-content">
          <h3 class="role">Module DevOps Lead</h3>
          <p class="company">Sopra Steria India</p>
          <ul class="responsibilities">
            <li>Lead DevOps engineering for Italy-based enterprise programs (Credem ICP & GenAI, Unieuro) within the DPS Delivery Unit, driving CI/CD, cloud infrastructure, and security initiatives across AKS environments.</li>
            <li>Upgraded AKS clusters to Kubernetes v1.35.3 (N-1 supported), implemented Liveness/Readiness probes to resolve pod health issues, and remediated infrastructure and penetration-test vulnerabilities.</li>
            <li>Designed AKS backup and VM patch management strategies for disaster recovery, and leading Terraform-based Blue-Green deployment architecture for Production AKS.</li>
            <li>Built and optimized end-to-end CI/CD pipelines using Azure DevOps, GitHub Actions, and GitLab, integrated with ArgoCD for GitOps-based AKS deployments.</li>
            <li>Implemented Infrastructure as Code (IaC) using Terraform for consistent, version-controlled provisioning.</li>
            <li>Containerized and deployed workloads via Docker, Helm, and AKS, applying DevSecOps practices with SonarQube.</li>
            <li>Established observability using Prometheus and Grafana for proactive monitoring.</li>
            <li>Automated infrastructure and operational workflows using Python, PowerShell, and Bash.</li>
          </ul>
          <div class="tags">
            <span class="tag">AKS</span>
            <span class="tag">Terraform</span>
            <span class="tag">Azure DevOps</span>
            <span class="tag">GitHub Actions</span>
            <span class="tag">GitLab</span>
            <span class="tag">ArgoCD</span>
            <span class="tag">Prometheus</span>
          </div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-date">Nov 2021 – June 2025</span>
        </div>
        <div class="timeline-content">
          <h3 class="role">DevOps Engineer</h3>
          <p class="company">Reliance PPM Services Limited</p>
          <ul class="responsibilities">
            <li>Automate and manage infrastructure on Azure using Terraform, Azure DevOps, and scripting languages (Bash, PowerShell, Azure CLI) to streamline resource provisioning.</li>
            <li>Leveraged Azure DevOps for end-to-end automation of build, test, and deployment pipelines.</li>
            <li>Implemented TFSec and TruffleHog for proactive security scanning of Terraform code repositories.</li>
            <li>Designed and implemented Infrastructure as Code (IaC) solutions using Terraform.</li>
            <li>Implemented containerization strategies using Docker and Kubernetes.</li>
          </ul>
          <div class="tags">
            <span class="tag">Azure</span>
            <span class="tag">Terraform</span>
            <span class="tag">Azure DevOps</span>
            <span class="tag">Kubernetes</span>
            <span class="tag">Docker</span>
          </div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-date">Apr 2021 – Oct 2021</span>
        </div>
        <div class="timeline-content">
          <h3 class="role">DevOps Engineer</h3>
          <p class="company">Valu Connex</p>
          <ul class="responsibilities">
            <li>Managed infrastructure on Azure cloud using Azure portal and ARM templates.</li>
            <li>Monitored and managed client's cloud infrastructure, creating Azure Virtual networks and subnets.</li>
            <li>Implemented Azure site-to-site and point-to-site VPNs.</li>
            <li>Configured Azure Load Balancer for efficient load distribution and traffic management.</li>
          </ul>
          <div class="tags">
            <span class="tag">Azure</span>
            <span class="tag">ARM Templates</span>
            <span class="tag">Networking</span>
          </div>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-date">Feb 2019 – Jun 2019</span>
        </div>
        <div class="timeline-content">
          <h3 class="role">Cloud Engineer</h3>
          <p class="company">Integrated Wireless Solutions Pvt. Ltd.</p>
          <ul class="responsibilities">
            <li>Monitored and managed client's cloud infrastructure efficiently.</li>
            <li>Created various resources including resource groups, V-net, subnet, Virtual Machines, NSG, SQL database.</li>
            <li>Utilized Azure pricing calculator for cost estimation.</li>
          </ul>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-date">Feb 2016 – Jan 2019</span>
        </div>
        <div class="timeline-content">
          <h3 class="role">Network Engineer</h3>
          <p class="company">Reliance SMSL Limited</p>
          <ul class="responsibilities">
            <li>Managed OLT finalization project for Jio services in UP West.</li>
            <li>Supported investigation and fault management for ISP access electronics.</li>
          </ul>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-date">May 2015 – Feb 2016</span>
        </div>
        <div class="timeline-content">
          <h3 class="role">Information Technology Engineer</h3>
          <p class="company">CMC Limited</p>
          <ul class="responsibilities">
            <li>Assigned to the Reliance JIO project, investigating and resolving technical issues while maintaining the office network infrastructure.</li>
            <li>Provided comprehensive hardware and software support to users, kept detailed asset records, and managed the infrastructure for a state office and JIO Centres.</li>
          </ul>
        </div>
      </div>

      <div class="timeline-item">
        <div class="timeline-meta">
          <span class="timeline-date">Aug 2011 – Mar 2014</span>
        </div>
        <div class="timeline-content">
          <h3 class="role">Associate - Customer Engineer</h3>
          <p class="company">HCL Infosystems Limited</p>
          <ul class="responsibilities">
            <li>Provided comprehensive customer support for both hardware and software on Windows and Linux platforms.</li>
            <li>Monitored customer hardware, configured hardware within networks, and ensured the seamless installation and troubleshooting of software and applications.</li>
            <li>Led the Dell project as a DSP support engineer and was recognized as a Dell Certified System Expert.</li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</Layout>

<style>
  .page-container {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-4xl);
  }

  .page-header {
    margin-bottom: var(--space-3xl);
  }

  .font-serif {
    font-family: var(--font-serif);
    font-size: 3rem;
    margin-bottom: var(--space-sm);
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: 1.25rem;
    margin: 0;
  }

  .timeline {
    position: relative;
    max-width: 800px;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(140px + 1rem); /* meta width + half gap */
    width: 1px;
    background-color: var(--border-color);
  }

  .timeline-item {
    display: flex;
    gap: var(--space-xl); /* 2rem */
    margin-bottom: var(--space-3xl);
    position: relative;
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-meta {
    width: 140px; /* Increased to fit date comfortably */
    flex-shrink: 0;
    text-align: right;
    padding-top: 6px;
  }

  .timeline-date {
    font-size: 0.85rem;
    color: var(--text-tertiary);
    font-weight: 500;
    display: block; /* ensure proper wrapping if needed */
    line-height: 1.4;
  }

  .timeline-content {
    flex: 1;
    position: relative;
    padding-bottom: var(--space-xl);
    min-width: 0; /* ensure it doesn't overflow flex container */
  }
  
  .timeline-item:not(:last-child) .timeline-content {
    border-bottom: 1px solid var(--border-color);
  }

  .timeline-content::before {
    content: '';
    position: absolute;
    top: 8px; /* align with first line */
    left: calc(-1rem - 5px); /* negative half gap - half circle width */
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--bg-color);
    border: 2px solid var(--text-tertiary);
  }

  .role {
    margin-top: 0;
    margin-bottom: var(--space-xs);
    font-family: var(--font-serif);
    font-size: 1.5rem;
  }

  .company {
    color: var(--text-secondary);
    font-weight: 500;
    margin-bottom: var(--space-md);
  }

  .responsibilities {
    list-style: none;
    padding: 0;
    margin-bottom: var(--space-lg);
  }

  .responsibilities li {
    position: relative;
    padding-left: var(--space-md);
    margin-bottom: var(--space-sm);
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .responsibilities li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--text-tertiary);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .tags .tag {
    background-color: var(--bg-color-secondary);
    border: 1px solid var(--border-color);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .stagger-1, .stagger-2 {
    opacity: 0;
    animation: slideUp var(--transition-slow) forwards;
  }

  @media (max-width: 600px) {
    .timeline::before {
      display: none;
    }
    
    .timeline-item {
      flex-direction: column;
      gap: var(--space-sm);
    }
    
    .timeline-meta {
      width: auto;
      text-align: left;
      padding-top: 0;
    }
    
    .timeline-content::before {
      display: none;
    }
    
    .timeline-item:not(:last-child) .timeline-content {
      border-bottom: none;
      padding-bottom: 0;
    }
    
    .timeline-item {
      border-bottom: 1px solid var(--border-color);
      padding-bottom: var(--space-xl);
    }
    
    .timeline-item:last-child {
      border-bottom: none;
    }
  }
</style>

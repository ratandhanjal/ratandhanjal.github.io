---
import Layout from '../layouts/Layout.astro';
import profileData from '../data/profile.json';

const expertiseAreas = [
  { title: 'Cloud Infrastructure', icon: '☁️', desc: 'Designing and operating scalable, resilient cloud infrastructure on Azure.' },
  { title: 'DevOps & CI/CD', icon: '⚙️', desc: 'End-to-end pipeline automation using Azure DevOps, GitHub Actions, and GitLab.' },
  { title: 'Infrastructure as Code', icon: '📄', desc: 'Version-controlled, repeatable provisioning with Terraform across all environments.' },
  { title: 'Kubernetes & Containers', icon: '🐳', desc: 'Designing, deploying, and operating AKS clusters and containerised workloads with Helm.' },
  { title: 'GitOps', icon: '🔁', desc: 'Declarative infrastructure and application delivery pipelines powered by ArgoCD.' },
  { title: 'DevSecOps', icon: '🔒', desc: 'Integrating security scanning (SonarQube, TFSec, TruffleHog) into CI/CD pipelines.' },
  { title: 'Observability & Reliability', icon: '📊', desc: 'Proactive monitoring, alerting, and incident response with Prometheus, Grafana, and Azure Monitor.' },
  { title: 'Automation & Scripting', icon: '⚡', desc: 'Reducing manual effort through Python, PowerShell, and Bash automation workflows.' },
  { title: 'Platform Engineering', icon: '🏗️', desc: 'Building developer platforms and self-service infrastructure tooling for engineering teams.' },
  { title: 'Network Engineering', icon: '🌐', desc: '15+ years of foundations in networking — VPNs, load balancers, NSGs, and private connectivity.' },
];

const techGroups = [
  { label: 'Cloud', items: ['Azure', 'AKS', 'Azure Container Registry', 'Azure Monitor'] },
  { label: 'IaC', items: ['Terraform', 'ARM Templates'] },
  { label: 'Containers', items: ['Kubernetes', 'Docker', 'Helm'] },
  { label: 'CI/CD & GitOps', items: ['Azure DevOps', 'GitHub Actions', 'GitLab CI', 'ArgoCD'] },
  { label: 'Security', items: ['SonarQube', 'TFSec', 'TruffleHog'] },
  { label: 'Observability', items: ['Prometheus', 'Grafana', 'Azure Monitor'] },
  { label: 'Scripting', items: ['Python', 'PowerShell', 'Bash', 'Azure CLI'] },
  { label: 'Source Control', items: ['Git', 'GitHub', 'GitLab', 'Azure Repos'] },
];
---

<Layout title={profileData.seo.title} description={profileData.seo.description}>

  <!-- ── Hero ───────────────────────────────────────────────────────────── -->
  <section class="hero-section flex flex-col items-center justify-center fade-in">
    <div class="container text-center">
      <div id="profile-img-trigger" class="profile-image-container hover-zoom" title="Click to zoom">
        <img src="/images/Ratan_Dhanjal.webp" alt={profileData.name} class="profile-image" />
      </div>

      <!-- Image Zoom Overlay -->
      <div id="image-overlay" class="image-overlay" aria-hidden="true">
        <button id="close-overlay" class="close-btn" aria-label="Close zoom">&times;</button>
        <img src="/images/Ratan_Dhanjal.webp" alt={profileData.name} class="zoomed-image" />
      </div>

      <p class="tag stagger-1">Cloud · DevOps · Platform Engineering</p>
      <h1 class="stagger-2 font-serif title">I'm {profileData.name}</h1>
      <h2 class="stagger-3 subtitle">{profileData.role}</h2>

      <p class="stagger-4 bio">
        I design, automate, and operate secure, scalable, and resilient cloud and infrastructure platforms.
        With 7+ years of hands-on experience spanning cloud engineering, DevOps, Kubernetes, IaC, and DevSecOps —
        I specialise in transforming complex infrastructure challenges into reliable, automated solutions.
      </p>

      <div class="flex justify-center gap-md stagger-5 mt-lg">
        <a href="/work" class="btn btn-primary" id="view-work-btn">View My Work</a>
        <a href="/projects" class="btn" id="view-projects-btn">Projects</a>
        <a href="/about" class="btn" id="about-me-btn">About Me</a>
      </div>
    </div>
  </section>

  <!-- ── Expertise Areas ────────────────────────────────────────────────── -->
  <section class="section-container fade-in" aria-labelledby="expertise-heading">
    <div class="container">
      <header class="section-header">
        <p class="tag">What I do</p>
        <h2 id="expertise-heading" class="section-title font-serif">Areas of Expertise</h2>
        <p class="section-subtitle">
          A decade-plus career spanning IT infrastructure, networking, cloud engineering, and modern DevOps practices.
        </p>
      </header>

      <div class="expertise-grid" role="list">
        {expertiseAreas.map((area) => (
          <article class="expertise-card" role="listitem">
            <span class="expertise-icon" aria-hidden="true">{area.icon}</span>
            <h3 class="expertise-title">{area.title}</h3>
            <p class="expertise-desc">{area.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Tech Stack ─────────────────────────────────────────────────────── -->
  <section class="section-container section-alt fade-in" aria-labelledby="stack-heading">
    <div class="container">
      <header class="section-header">
        <p class="tag">Tools & Platforms</p>
        <h2 id="stack-heading" class="section-title font-serif">Technology Stack</h2>
        <p class="section-subtitle">
          The tools and platforms I work with daily to build, secure, and operate production infrastructure.
        </p>
      </header>

      <div class="stack-groups">
        {techGroups.map((group) => (
          <div class="stack-group">
            <span class="stack-label">{group.label}</span>
            <div class="stack-tags">
              {group.items.map((item) => (
                <span class="stack-tag">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA Strip ──────────────────────────────────────────────────────── -->
  <section class="cta-strip fade-in">
    <div class="container cta-inner">
      <div>
        <p class="tag">Open to opportunities</p>
        <h2 class="cta-title font-serif">Let's build something together.</h2>
        <p class="cta-text">Available for cloud architecture consulting, DevOps leadership, and platform engineering engagements.</p>
      </div>
      <a href="/contact" class="btn btn-primary cta-btn" id="contact-cta-btn">Get in Touch</a>
    </div>
  </section>

</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.getElementById('profile-img-trigger');
    const overlay = document.getElementById('image-overlay');
    const closeBtn = document.getElementById('close-overlay');
    const zoomedImg = overlay?.querySelector('.zoomed-image') as HTMLImageElement;

    if (trigger && overlay && closeBtn && zoomedImg) {
      trigger.addEventListener('click', () => {
        const rect = trigger.getBoundingClientRect();
        zoomedImg.style.top = `${rect.top}px`;
        zoomedImg.style.left = `${rect.left}px`;
        zoomedImg.style.width = `${rect.width}px`;
        zoomedImg.style.height = `${rect.height}px`;
        zoomedImg.style.transform = 'none';
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
        void zoomedImg.offsetWidth;
        const size = Math.min(window.innerWidth * 0.9, window.innerHeight * 0.9, 500);
        zoomedImg.style.top = '50%';
        zoomedImg.style.left = '50%';
        zoomedImg.style.width = `${size}px`;
        zoomedImg.style.height = `${size}px`;
        zoomedImg.style.transform = 'translate(-50%, -50%)';
      });

      const closeZoom = () => {
        const rect = trigger.getBoundingClientRect();
        zoomedImg.style.top = `${rect.top}px`;
        zoomedImg.style.left = `${rect.left}px`;
        zoomedImg.style.width = `${rect.width}px`;
        zoomedImg.style.height = `${rect.height}px`;
        zoomedImg.style.transform = 'none';
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      };

      closeBtn.addEventListener('click', closeZoom);
      overlay.addEventListener('click', (e) => { if (e.target === overlay) closeZoom(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && overlay.classList.contains('active')) closeZoom(); });
    }
  });
</script>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────────── */
  .hero-section {
    min-height: calc(100vh - 200px);
    padding: var(--space-3xl) 0;
  }

  .profile-image-container {
    width: 160px;
    height: 160px;
    margin: 0 auto var(--space-xl) auto;
    border-radius: var(--radius-full);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    border: 4px solid var(--border-color);
    cursor: zoom-in;
  }

  :global([data-theme='dark']) .profile-image-container {
    box-shadow: 0 10px 30px rgba(255, 255, 255, 0.05);
  }

  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-full);
  }

  .image-overlay {
    position: fixed; top: 0; left: 0;
    width: 100vw; height: 100vh;
    background-color: rgba(0, 0, 0, 0.85);
    z-index: 9999; opacity: 0; pointer-events: none;
    transition: opacity 0.4s ease;
    backdrop-filter: blur(5px);
  }
  .image-overlay.active { opacity: 1; pointer-events: auto; cursor: zoom-out; }
  .zoomed-image {
    object-fit: cover; border-radius: 50%;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    position: absolute;
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: default; margin: 0;
  }
  .close-btn {
    position: absolute; top: 20px; right: 30px;
    background: none; border: none; color: white;
    font-size: 3rem; cursor: pointer; line-height: 1;
    z-index: 10000; transition: transform 0.2s ease;
  }
  .close-btn:hover { transform: scale(1.1); }

  .font-serif { font-family: var(--font-serif); }
  .text-center { text-align: center; }

  .title {
    margin-top: var(--space-sm); margin-bottom: var(--space-xs);
    font-size: clamp(2.5rem, 5vw, 4rem);
  }

  .subtitle {
    margin-top: 0; color: var(--text-secondary);
    font-weight: 500;
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    margin-bottom: var(--space-xl);
  }

  .bio {
    max-width: 640px; margin: 0 auto;
    font-size: 1.05rem; color: var(--text-secondary); line-height: 1.8;
  }

  .mt-lg { margin-top: var(--space-xl); }

  .tag, .title, .subtitle, .bio, .stagger-5 {
    opacity: 0;
    animation: slideUp var(--transition-slow) forwards;
  }
  .stagger-1 { animation-delay: 100ms; }
  .stagger-2 { animation-delay: 200ms; }
  .stagger-3 { animation-delay: 300ms; }
  .stagger-4 { animation-delay: 400ms; }
  .stagger-5 { animation-delay: 500ms; }

  /* ── Shared Section Styles ─────────────────────────────────────────────── */
  .section-container {
    padding: var(--space-3xl) 0;
    border-top: 1px solid var(--border-color);
  }

  .section-alt {
    background-color: var(--bg-color-secondary);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .section-header .tag {
    display: block;
    margin-bottom: var(--space-sm);
    opacity: 1;
    animation: none;
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin: 0 0 var(--space-md) 0;
  }

  .section-subtitle {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── Expertise Grid ────────────────────────────────────────────────────── */
  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-lg);
  }

  .expertise-card {
    background-color: var(--bg-color-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    transition: border-color var(--transition-fast), transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .expertise-card:hover {
    border-color: var(--border-color-hover);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
  }

  :global([data-theme='dark']) .expertise-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.3);
  }

  .expertise-icon {
    font-size: 1.75rem;
    display: block;
    margin-bottom: var(--space-md);
    line-height: 1;
  }

  .expertise-title {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 var(--space-sm) 0;
    color: var(--text-color);
  }

  .expertise-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* ── Tech Stack ────────────────────────────────────────────────────────── */
  .stack-groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 720px;
    margin: 0 auto;
  }

  .stack-group {
    display: flex;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  .stack-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    flex-shrink: 0;
    width: 90px;
    padding-top: 5px;
  }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .stack-tag {
    font-size: 0.8rem;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-color);
    background-color: var(--bg-color);
    color: var(--text-secondary);
    font-weight: 500;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .stack-tag:hover {
    border-color: var(--border-color-hover);
    color: var(--text-color);
  }

  /* ── CTA Strip ─────────────────────────────────────────────────────────── */
  .cta-strip {
    padding: var(--space-3xl) 0;
    border-top: 1px solid var(--border-color);
  }

  .cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2xl);
  }

  .cta-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: var(--space-xs) 0 var(--space-sm) 0;
  }

  .cta-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.6;
    max-width: 420px;
  }

  .cta-btn {
    flex-shrink: 0;
    font-size: 0.95rem;
    padding: var(--space-sm) var(--space-2xl);
  }

  /* ── Responsive ────────────────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .expertise-grid {
      grid-template-columns: 1fr 1fr;
    }

    .stack-group {
      flex-direction: column;
      gap: var(--space-sm);
    }

    .stack-label {
      width: auto;
    }

    .cta-inner {
      flex-direction: column;
      text-align: center;
    }

    .cta-text {
      max-width: 100%;
    }
  }

  @media (max-width: 420px) {
    .expertise-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
